# Copy this file to .env before production deployment.
SECRET_KEY=change-me-to-a-long-random-string
REMEMBER_DAYS=30
# Set to true only when the site is served through HTTPS.
COOKIE_SECURE=false
FLASK_CONFIG_CLASS=config.ProductionConfig
PORT=8000
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
DATABASE_URL=sqlite:///instance/bitcrm.db
